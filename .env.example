# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1
DEMO_MODE=true

# Bedrock Agent Configuration
BEDROCK_AGENT_ID=SUPPORT_AGNT001
BEDROCK_AGENT_ALIAS_ID=PROD_ALIAS

# OpenSearch Serverless (Knowledge Base)
OPENSEARCH_ENDPOINT=https://xxxx.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=support-runbooks

# Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_APP_CLIENT_ID=xxxxx

# CloudWatch Logging
CLOUDWATCH_LOG_GROUP=/aws/bedrock/support-agent-traces
TENANT_LOG_GROUP=/aws/application/tenant-logs

# DynamoDB Tables
DYNAMODB_CRM_TABLE=support-crm-records
DYNAMODB_STATE_TABLE=support-tenant-state
